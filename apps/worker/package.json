{
  "name": "@blacklist/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Blacklist background job runner (pg-boss): evidence scanning, risk recomputation, notifications, email, chain finality checks, scheduled maintenance.",
  "type": "module",
  "dependencies": {
    "@blacklist/config": "workspace:*",
    "@blacklist/core": "workspace:*",
    "@blacklist/domain": "workspace:*",
    "zod": "4.6.5",
    "nodemailer": "10.0.14"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node src/main.ts"
  }
}
