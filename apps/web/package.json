{
  "name": "@blacklist/web",
  "version": "0.0.0",
  "private": true,
  "description": "Blacklist web application (Next.js App Router). UI only: no database access, no domain logic.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-mock.mjs dev",
    "build": "next build",
    "build:mock": "node scripts/run-mock.mjs build",
    "start:mock": "node scripts/run-mock.mjs start",
    "start": "next start",
    "check:mock-exclusion": "node scripts/check-mock-exclusion.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blacklist/contracts": "workspace:*",
    "@blacklist/core": "workspace:*",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
