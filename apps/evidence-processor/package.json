    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
