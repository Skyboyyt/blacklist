# =============================================================================
# Blacklist — environment variables (EXAMPLE ONLY)
# =============================================================================
# - Copy to `.env` for LOCAL development only. `.env` is git-ignored.
# - Placeholder values only. NEVER put real credentials in this file.
# - Production/staging secrets come from the hosting platform's secret store.
# - Server-only variables must NEVER use the NEXT_PUBLIC_ prefix.
# - packages/config validates api/worker variables at startup (Phase 7) and
#   refuses to start when required values are missing or malformed.
# - Phase 7 implements the API/worker identity foundation. Later-phase RPC,
#   storage and monitoring settings remain inactive unless separately approved.
# =============================================================================

# ---- Application -------------------------------------------------------------
NODE_ENV=development
# Hosting environment; staging enables a supplemental server-to-server ingress gate.
DEPLOYMENT_ENV=local
# Staging only: independent CSPRNG base64url secret, >=32 characters; API and Vercel server only.
# STAGING_ACCESS_TOKEN=replace-with-independent-random-staging-secret
# Public origin serving both the web app and /api (same-origin deployment).
# Every state-changing request must carry exactly this Origin.
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ---- Web app (public, non-secret build configuration) ----------------------
# "mock" serves fictional data from the mock adapter (development and tests only).
# Leave unset for any real deployment: the mock is then excluded from the build.
# NEXT_PUBLIC_API_MODE=mock

# ---- Web server (SSR) — server-only live adapter and Next rewrite -----------
# Private-network URL the Next.js server uses for GET-only reads.
API_INTERNAL_URL=http://localhost:4000
# Shared secret proving SSR requests come from the web tier (enables trusted
# client-IP forwarding). CSPRNG, >= 32 bytes. Rotate on exposure.
INTERNAL_API_TOKEN=replace-with-random-32-byte-secret

# ---- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Render sets PORT; infrastructure/render/run.mjs maps it to API_PORT and binds 0.0.0.0.
# PORT=10000
# Comma-separated CIDRs of trusted reverse proxies (edge). Forwarded headers from
# anyone else are ignored.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# ---- Database (PostgreSQL) ---------------------------------------------------
# Application role: DML only (append-only tables: INSERT/SELECT; audit via append function).
DATABASE_URL=postgres://blacklist_app:change-me@localhost:5432/blacklist
# Migration role: DDL (including the pg-boss schema). Used ONLY by the deploy step.
DATABASE_MIGRATION_URL=postgres://blacklist_migrator:change-me@localhost:5432/blacklist
# Separate temporary operator only; neither flag belongs to API/worker settings.
OPERATOR_ENABLED=false
OPERATOR_INSPECT_ONLY=false
# Cloud operator credentials/control token belong only in its protected runtime JSON file.
# Existing local/operator scripts consume DATABASE_ADMIN_URL, BLACKLIST_RUNTIME_PASSWORD,
# BLACKLIST_MIGRATOR_PASSWORD. Never put those variables on API/worker or Docker builds.

# ---- Authentication (docs/design/identity.md) --------------------------------
# Signs Better Auth session cookies (HMAC). >= 32 random bytes. Must never be
# stored in the database, backups, logs or client bundles (exception E-1).
# Rotating it invalidates every session.
BETTER_AUTH_SECRET=replace-with-random-32-byte-secret
# WebAuthn relying party (must match the APP_ORIGIN host).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Blacklist
# Human-verification provider (open decision O-6; e.g. Cloudflare Turnstile).
HUMAN_VERIFICATION_SECRET_KEY=replace-me
NEXT_PUBLIC_HUMAN_VERIFICATION_SITE_KEY=replace-me
# Breached-password check (HIBP range API, k-anonymity; no key required).
# When unavailable, the bundled local blocklist is used (never unconditional acceptance).
BREACHED_PASSWORD_CHECK_ENABLED=true
# Break-glass staff recovery. Must stay false; set true only during a recorded
# incident (identity design §10.13).
BREAK_GLASS_ENABLED=false

# ---- Blockchain providers (selection is open decision O-3, Phase 8) ----------
# Provider keys are secrets. Restrict them by IP/origin at the provider when possible.
SOLANA_PRIMARY_PROVIDER=helius
HELIUS_API_KEY=replace-me
SOLANA_SECONDARY_RPC_URL=https://solana-rpc.example.invalid
EVM_PRIMARY_PROVIDER=alchemy
ALCHEMY_API_KEY=replace-me
ETHEREUM_SECONDARY_RPC_URL=https://ethereum-rpc.example.invalid
# Explorer source verification is external_source data (review commercial terms).
ETHERSCAN_API_KEY=replace-me
# Controlled DNS resolver for DNS TXT standing checks (no HTTP fetching).
DNS_RESOLVER_URL=https://dns-resolver.example.invalid/dns-query

# ---- Object storage (S3-compatible; MinIO locally) ---------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_QUARANTINE=blacklist-quarantine
S3_BUCKET_EVIDENCE=blacklist-evidence
S3_BUCKET_DERIVATIVES=blacklist-derivatives
# Separate registrable domain derivative downloads are served from (never the app origin).
EVIDENCE_DOWNLOAD_ORIGIN=http://localhost:9000

# ---- Evidence processor (apps/evidence-processor) ----------------------------
# The worker calls it over the internal network. The processor itself receives NO
# secrets: only scoped presigned URLs per job and the non-secret limits below.
EVIDENCE_PROCESSOR_URL=http://localhost:4100
EVIDENCE_PROCESSOR_PORT=4100
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_MAX_MEGAPIXELS=40
EVIDENCE_MAX_DIMENSION_PX=12000

# ---- Email (SMTP; Mailpit locally) -------------------------------------------
EMAIL_PROVIDER=smtp
# Render staging uses EMAIL_PROVIDER=resend and Resend's fixed HTTPS API.
# RESEND_API_KEY=replace-with-staging-sending-only-api-key
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@blacklist.example
# false is for loopback Mailpit only; production requires TLS.
SMTP_SECURE=false

# ---- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5
# Optional status-only listener for a separate free Render web-hosted staging worker.
# WORKER_HEALTH_PORT=10000

# ---- Observability -----------------------------------------------------------
# Error tracking (open decision O-5). Leave empty: external export stays off until decided.
ERROR_TRACKING_DSN=
# OpenTelemetry collector endpoint. Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=blacklist

# ---- Intentionally absent ----------------------------------------------------
# Redis: not used in V1 (ARCHITECTURE.md §3).
# ClamAV / antivirus: deferred with image-only evidence (ADR 0004).
# Sanctions list settings: deferred until legal review (chain-data design §8).
