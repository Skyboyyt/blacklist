{
  "name": "blacklist",
  "version": "0.0.0",
  "private": true,
  "description": "Blacklist — Web3 anti-scam research, wallet intelligence and investigation platform. Phase 1 (frontend foundation): UI on contracts and mocks; no production backend.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.20.0 <25.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm --filter @blacklist/web run build",
    "test:e2e": "pnpm --filter @blacklist/e2e run e2e",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
