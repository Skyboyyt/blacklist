{
  "name": "@blacklist/backend-acceptance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated Phase 7 acceptance spikes; not production authentication or migrations.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run .integration.test.ts",
    "schema:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test:runtime": "vitest run runtime.integration.test.ts",
    "test:coverage": "vitest run runtime.integration.test.ts runtime-security.test.ts application-migrations.integration.test.ts delivery-locking.integration.test.ts render-deployment.test.ts render-deployment.integration.test.ts resend.test.ts worker-health.test.ts ingress-diagnostics.test.ts mail-worker-wake.test.ts chain-storage.integration.test.ts research.integration.test.ts --coverage",
    "test:chain-coverage": "vitest run --root ../../packages/chains --coverage --coverage.include 'src/**/*.ts' --coverage.thresholds.branches 75 --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=/tmp/blacklist-phase8-chains-coverage"
  },
  "devDependencies": {
    "@blacklist/api": "workspace:*",
    "@blacklist/config": "workspace:*",
    "@blacklist/contracts": "workspace:*",
    "@blacklist/db": "workspace:*",
    "@blacklist/domain": "workspace:*",
    "@blacklist/worker": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "@playwright/test": "1.63.0",
    "@simplewebauthn/server": "14.0.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.2",
    "better-auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
